# --- Database ---------------------------------------------------------------

# Required. PostgreSQL connection string.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://jobradar:change-me@localhost:5432/jobradar

# Optional. How long to wait for the initial database connection.
# Accepts Go duration syntax: "10s", "1m", "500ms". Default: 15s.
DB_CONNECT_TIMEOUT=15s

# --- Logging ----------------------------------------------------------------

# Optional. Minimum log level.
# One of: debug | info | warn | error. Default: info.
# Set to "debug" to see per-page progress lines.
JOBRADAR_LOG_LEVEL=info

# Optional. Log output format.
# One of: text | json. Default: text.
# Use "json" when logs are collected by machines (systemd, CI, jq).
JOBRADAR_LOG_FORMAT=text

# --- Debugging --------------------------------------------------------------

# Optional. Directory where every HTTP request/response is dumped to files.
# Leave empty to disable dumping (recommended outside debugging sessions).
JOBRADAR_DEBUG_DIR=